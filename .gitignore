# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/
build/
dist/
htmlcov/
.coverage
.coverage.*

# --- Node / bun (frontend) ---
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# --- Agent worktrees (transient; nested inside the repo, must not be linted/searched) ---
.claude/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# NOTE: uv.lock and bun.lockb ARE committed (CI runs --locked / --frozen-lockfile).

# --- internal working plans (never published) ---
# These are the build's own planning/handoff notes. They live in the working tree
# on purpose but must never reach a commit or a PR diff -- a `git add -A` swept
# them in once, which is exactly what this entry exists to prevent.
/PLAN.md
/docs/plan/
